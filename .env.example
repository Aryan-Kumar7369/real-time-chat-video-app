# ==========================================
# 1. LOCAL DOCKER COMPOSE CONFIGURATION
# ==========================================
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=secure_password
POSTGRES_DB_NAME=chatapp

# ==========================================
# 2. BACKEND SERVER CONFIGURATION (backend/.env)
# ==========================================
PORT=5000
JWT_SECRET=your_super_secure_jwt_secret_key_here

# For Cloud Postgres (Neon.tech):
# DATABASE_URL=postgresql://user:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/chatapp?sslmode=require

# For Local Postgres (Docker):
DB_USER=postgres
DB_PASSWORD=secure_password
DB_NAME=chatapp
DB_PORT=5432
DB_HOST=localhost

# Allowed Frontend Origins for CORS (comma-separated if multiple):
CLIENT_URL=http://localhost:5173

# Optional: At-rest database encryption key (defaults to SHA256 of JWT_SECRET if omitted):
# DB_ENCRYPTION_KEY=your_db_encryption_key_here

# ==========================================
# 3. FRONTEND CONFIGURATION (frontend/.env)
# ==========================================
# For local development:
VITE_BACKEND_URL=http://localhost:5000

# For production deployment (Vercel):
# VITE_BACKEND_URL=vercel_url